+              },
+            ),
+            FilledButton.icon(
+              onPressed: _busy ? null : _add,
+              icon: const Icon(Icons.add),
+              label: Text(_busy ? 'Загрузка…' : 'Добавить посещение'),
+            ),
+            if (_error != null)
+              TextButton(
+                onPressed: _load,
+                child: const Text('Повторить загрузку'),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
