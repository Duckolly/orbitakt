+class RankAnimal extends StatelessWidget {
+  const RankAnimal(this.rank, {super.key, this.size = 48});
+  final RankLevel? rank;
+  final double size;
+  @override
+  Widget build(BuildContext context) => Semantics(
+    label: rank?.animal ?? 'Без животного',
+    child: rank?.animal == 'Эму'
+        ? CustomPaint(
+            size: Size.square(size),
+            painter: _EmuPainter(Theme.of(context).colorScheme.primary),
+          )
+        : Text(rank?.icon ?? '○', style: TextStyle(fontSize: size)),
+  );
+}
+
+class _EmuPainter extends CustomPainter {
+  const _EmuPainter(this.color);
+  final Color color;
+  @override
+  void paint(Canvas canvas, Size size) {
+    canvas.save();
+    canvas.scale(size.width / 64, size.height / 64);
+    final p = Paint()..color = color;
+    canvas.drawOval(const Rect.fromLTWH(10, 23, 35, 24), p);
+    canvas.drawPath(
+      Path()
+        ..moveTo(37, 31)
+        ..quadraticBezierTo(51, 30, 44, 10)
+        ..lineTo(49, 10)
+        ..quadraticBezierTo(58, 39, 41, 40)
+        ..close(),
+      p,
+    );
+    canvas.drawOval(const Rect.fromLTWH(42, 4, 12, 10), p);
+    canvas.drawPath(
+      Path()
+        ..moveTo(52, 8)
+        ..lineTo(61, 12)
+        ..lineTo(52, 12)
+        ..close(),
+      p,
+    );
+    p
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 3
+      ..strokeCap = StrokeCap.round;
+    canvas.drawPath(
+      Path()
+        ..moveTo(23, 44)
+        ..lineTo(20, 58)
+        ..lineTo(14, 60)
+        ..moveTo(33, 44)
+        ..lineTo(36, 58)
+        ..lineTo(43, 60),
+      p,
+    );
+    p
+      ..style = PaintingStyle.fill
+      ..color = Colors.white;
+    canvas.drawCircle(const Offset(50, 8), 1.5, p);
+    canvas.restore();
+  }
+
+  @override
+  bool shouldRepaint(_EmuPainter oldDelegate) => color != oldDelegate.color;
+}
